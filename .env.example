# Copy to .env; never commit credentials. Default is explicit demo mode.
HOST=127.0.0.1
PORT=3000
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Optional OpenAI-compatible chat completions endpoint base (ends in /v1).
# Official ima OpenAPI: POST /openapi/wiki/v1/search_knowledge and get_media_info
IMA_BASE_URL=https://ima.qq.com
IMA_CLIENT_ID=
IMA_API_KEY=
IMA_KNOWLEDGE_BASE_ID=
# Blank resolves sibling knowledge directory, then bundled non-factual demo guide.
LOCAL_KNOWLEDGE_DIR=
API_TIMEOUT_MS=20000
